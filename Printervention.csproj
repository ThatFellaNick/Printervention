<!--
  Printervention
  Lightweight Windows printer driver discovery and queue setup tool.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Printervention</RootNamespace>
    <AssemblyName>Printervention</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>Printervention</Company>
    <Description>Official-vendor printer driver and Windows print queue installer</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\Printervention.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
